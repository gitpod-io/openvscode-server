<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Embed and reverse-proxy the OpenVSCode Server through an ASP.NET Core / Kestrel host.</Description>
    <PackageId>OpenVSCodeServer.Kestrel</PackageId>
    <AssemblyName>OpenVSCodeServer.Kestrel</AssemblyName>
    <RootNamespace>OpenVSCodeServer.Kestrel</RootNamespace>
    <IsPackable>true</IsPackable>

    <Authors>OpenVSCodeServer.Kestrel contributors</Authors>
    <Company>OpenVSCodeServer.Kestrel contributors</Company>
    <Product>OpenVSCodeServer.Kestrel</Product>
    <Copyright>Copyright (c) Microsoft Corporation. All rights reserved.</Copyright>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/theolivenbaum/openvscode-server</PackageProjectUrl>
    <RepositoryUrl>https://github.com/theolivenbaum/openvscode-server</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vscode;openvscode-server;ide;kestrel;aspnetcore;reverse-proxy</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed every packaged distribution found in EmbeddedAssets. -->
    <EmbeddedResource Include="EmbeddedAssets\*.tar.gz" Condition="Exists('EmbeddedAssets')" LogicalName="OpenVSCodeServer.Kestrel.EmbeddedAssets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="EmbeddedAssets\README.md" Condition="Exists('EmbeddedAssets\README.md')" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
